# Prefer Render's internal PostgreSQL DATABASE_URL in production.
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=planetpulse
JWT_SECRET_KEY=
# Optional comma-separated frontend origins for production. Local dev origins are the default.
# CORS_ORIGINS=https://your-frontend.example.com

# Optional factor overrides (kg CO2e per unit); defaults documented in DECISIONS.md
# PLANETPULSE_FACTOR_CAR_PER_KM=0.29
# PLANETPULSE_FACTOR_METRO_PER_KM=0.105
# PLANETPULSE_FACTOR_ELECTRICITY_PER_KWH=0.716
